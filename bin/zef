#!/usr/bin/env php
<?php

/**
 * ZEF Framework v2.16.0 — CLI binary (thin composition root).
 *
 * Usage:
 *   bin/zef                        Show version banner.
 *   bin/zef list [--json]          Print the full command catalog.
 *   bin/zef --self-test            Run the full self-test suite (v2.7.0 baseline
 *                                  + the v2.8.0 feature suite).
 *   bin/zef --self-test=<key>      Run only matching suites (case-insensitive
 *                                  substring match on suite key or label),
 *                                  e.g. v280, v270, router, psr.
 *   bin/zef --serve [addr]         Start the built-in development server
 *                                  (default 0.0.0.0:8080, serves public/index.php).
 *
 * v2.8.0 developer tools:
 *   bin/zef route:list             Print every registered route (boots the app).
 *   bin/zef make:module <name>     Scaffold modules/<name>/ (ConfigProvider + handler).
 *   bin/zef make:handler <Name> [--module=<name>] [--path=/uri]
 *                                  Scaffold a PSR-15 handler inside a module.
 *   bin/zef make:middleware <Name> Scaffold a src/Middleware PSR-15 middleware.
 *
 * v2.10.0 developer tools:
 *   bin/zef tinker [-e <expr>] [--no-boot] [--force]
 *                                  Interactive REPL (state persists per line).
 *                                  -e evaluates one expression and exits.
 *                                  --no-boot skips application boot.
 *                                  --force allows tinker when ZEF_ENV=production.
 *
 * v2.16.0 ZEF Maker — scaffold anything from the CLI:
 *   bin/zef make:plugin <Name>     Scaffold plugins/<Name>/ (Provider+Service+Handler).
 *   bin/zef make:config <Name> [--module=<name>]
 *                                  Scaffold a module ConfigProvider.
 *   bin/zef make:command <Name> [--module=<name>]
 *                                  Scaffold a CQRS command + handler.
 *   bin/zef make:query <Name> [--module=<name>]
 *                                  Scaffold a CQRS query + handler.
 *   bin/zef make:entity <Name> [--module=<name>]
 *                                  Scaffold a Domain entity.
 *   bin/zef make:valueobject <Name> [--module=<name>]
 *                                  Scaffold a final readonly value object.
 *   bin/zef make:service <Name> [--module=<name>]
 *                                  Scaffold an application service.
 *   bin/zef module:list            Print registered modules (boots the app).
 *   bin/zef plugin:list            Print plugins found on disk.
 *   bin/zef config:show [key]      Dump aggregated config / one dotted key.
 *                                  [--reveal] unmask secret-valued keys
 *                                  (refuses under ZEF_ENV=production).
 *
 * v2.20.0 OpenAPI documentation module:
 *   bin/zef openapi:generate       Assemble the OpenAPI 3.1 document from the
 *                                  route table (--format=json|yaml,
 *                                  --output=<path>, --pretty/--no-pretty,
 *                                  --postman=<path> for a Postman v2.1 export,
 *                                  --base-url=<url> to add a server entry).
 *
 * v2.29.0 DX release — standalone apps + RoadRunner transparency:
 *   bin/zef make:app <path>        Scaffold a standalone ZEF application at
 *                                  <path> (composer.json + composition root
 *                                  + Home module + .rr.yaml + entrypoints).
 *                                  [--name=<project>] [--address=host:port]
 *   bin/zef rr:init                Generate .rr.yaml from ZEF_* env knobs
 *                                  and flags (--address=, --workers=,
 *                                  --max-jobs=, --memory=; --force refreshes).
 *   bin/zef doctor                 Read-only environment preflight (PHP,
 *                                  extensions, autoloader, RR binary/bridge,
 *                                  app-boot smoke). Exit 1 only on FAIL.
 *
 * v2.32.0 Unified queue drivers:
 *   bin/zef queue:work             Process jobs from the wired queue driver
 *                                  (InMemory, PDO, or Redis Streams) via
 *                                  InProcessJobWorker.
 *                                  [--once] drain and exit when empty;
 *                                  [--max=<n>] stop after n jobs;
 *                                  [--memory=<mb>] leak guard — exit 2 when
 *                                  real usage crosses the MiB budget so the
 *                                  supervisor replaces the process.
 *                                  Requires InProcessJobWorker wired in the
 *                                  container.
 *   bin/zef queue:failed           List dead-lettered jobs from the wired
 *                                  failed-job queue (any JobQueueInterface;
 *                                  typically a dedicated RedisStreamJobQueue
 *                                  stream or a PDO table).
 *                                  [--max=<n>] entry budget (default 50).
 *   bin/zef queue:retry            Move dead-lettered jobs back to the main
 *                                  queue (envelope as-is, attempt kept).
 *                                  [--max=<n>] move at most n (default 50);
 *                                  [--all] move every entry.
 *   bin/zef queue:flush            Purge dead-lettered jobs from the wired
 *                                  failed-job queue.
 *                                  [--max=<n>] purge at most n (default all).
 *
 * v2.31.0 Outbox relay worker (lease-based, concurrent-safe):
 *   bin/zef outbox:work            Relay outbox entries to the event bus via
 *                                  lease claiming — safe with N workers.
 *                                  [--once] drain one batch and exit;
 *                                  [--batch=<n>] claim size (default 100);
 *                                  [--lease=<sec>] lease window (default 30);
 *                                  [--interval=<ms>] idle poll (default 500);
 *                                  [--max=<n>] stop after n batches.
 *                                  Requires OutboxRelay wired in the container.
 */

declare(strict_types=1);

require __DIR__ . '/../autoload/zef_autoload.php';

if (PHP_VERSION_ID < 80400) {
    fwrite(STDERR, "ZEF Framework v" . \Zef\Framework\Foundation\ZefVersion::VERSION . " requires PHP >= 8.4\n");
    exit(1);
}

$args = $_SERVER['argv'] ?? [];

if (in_array('--self-test', $args, true)) {
    exit((new \Zef\Test\CliRunner())->run(false));
}

foreach ($args as $selfTestArg) {
    if (str_starts_with((string) $selfTestArg, '--self-test=')) {
        $filter = substr((string) $selfTestArg, 12);
        if (trim($filter) === '') {
            fwrite(STDERR, "Empty --self-test filter. Example: bin/zef --self-test=v280\n");
            exit(1);
        }
        exit((new \Zef\Test\CliRunner())->run(false, $filter));
    }
}

$serveIdx = array_search('--serve', $args, true);
if ($serveIdx !== false) {
    $addr = $args[$serveIdx + 1] ?? '0.0.0.0:8080';
    if (!preg_match('/^[0-9.]+:[0-9]{1,5}$/', $addr) && !preg_match('/^\[[0-9a-f:]+\]:[0-9]{1,5}$/', $addr)) {
        fwrite(STDERR, "Invalid listen address '{$addr}'. Expected host:port.\n");
        exit(1);
    }
    $cmd = escapeshellarg(PHP_BINARY) . ' -S ' . escapeshellarg($addr)
        . ' ' . escapeshellarg(__DIR__ . '/../public/index.php');
    fwrite(STDOUT, "ZEF dev server listening on http://{$addr}\n");
    passthru($cmd, $code);
    exit($code);
}

// ---------------------------------------------------------------------------
// Developer experience commands
// ---------------------------------------------------------------------------

$command = $args[1] ?? null;
$root = dirname(__DIR__);
$io = new \Zef\Framework\Console\ConsoleIO();
$maker = new \Zef\Framework\Console\ZefMaker($root, $io);

if ($command === 'route:list') {
    exit(zef_route_list($args));
}

if ($command === 'module:list') {
    $app = \Zef\App\Bootstrap::createApp(false);
    $app->boot();
    exit((new \Zef\Framework\Console\Inspector\ModuleLister($app->getModuleRegistry(), $io))->run());
}

if ($command === 'plugin:list') {
    exit((new \Zef\Framework\Console\Inspector\PluginLister($root, $io))->run());
}

if ($command === 'config:show') {
    // Flags (--reveal) are stripped before the positional key; the first
    // non-flag argument wins, keeping `config:show --reveal db.password`
    // and `config:show db.password --reveal` equivalent.
    $keyArg = null;
    $reveal = false;
    foreach (array_slice($args, 2) as $arg) {
        if ($arg === '--reveal') {
            $reveal = true;
            continue;
        }
        if (is_string($arg) && str_starts_with($arg, '--')) {
            continue;
        }
        $keyArg ??= $arg;
    }
    $app = \Zef\App\Bootstrap::createApp(false);
    $app->boot();
    try {
        exit((new \Zef\Framework\Console\Inspector\ConfigShower($app->getConfigAggregator(), $io))->run($keyArg, $reveal));
    } catch (\Zef\Framework\Console\ConsoleException $e) {
        $io->err($e->getMessage());
        exit(1);
    }
}

if ($command === 'tinker') {
    exit(zef_tinker($args));
}

if ($command === 'openapi:generate') {
    exit(zef_openapi_generate($args));
}

if ($command === 'rr:init') {
    $writer = new \Zef\Framework\Console\ScaffoldWriter($io);
    exit((new \Zef\Framework\Console\Generator\RoadRunnerConfigGenerator($root, $io, $writer))->generate(null, array_slice($args, 2)));
}

if ($command === 'doctor') {
    // The RR-bridge probe asks class_exists() about composer packages; load
    // the composer autoloader when present so an installed checkout does not
    // get a false "missing" warning. The zero-composer autoloader stays the
    // base (class_exists guards make double registration a no-op).
    if (is_file(__DIR__ . '/../vendor/autoload.php')) {
        require_once __DIR__ . '/../vendor/autoload.php';
    }

    // Boot probe injected by the composition root: Infrastructure (Doctor)
    // must not depend on the App layer (Deptrac), so the boot closure is
    // wired here where the App dependency is legal.
    $bootSmoke = static function (): string {
        $app = \Zef\App\Bootstrap::createApp(false);
        $app->boot();

        return 'Application booted (ZEF v' . \Zef\Framework\Foundation\ZefVersion::VERSION . ')';
    };
    exit((new \Zef\Framework\Console\Inspector\Doctor($root, $io, $bootSmoke))->run());
}

if ($command === 'queue:work') {
    $app = \Zef\App\Bootstrap::createApp(false);
    $app->boot();
    $container = $app->getContainer();
    $workerFactory = static function () use ($container): \Zef\Framework\Job\InProcessJobWorker {
        $id = \Zef\Framework\Job\InProcessJobWorker::class;
        if (!$container->has($id)) {
            throw new \RuntimeException(
                "InProcessJobWorker ({$id}) is not wired in the container.\n"
                . 'Register it from a ConfigProvider, e.g.:'
                . "\n  new InProcessJobWorker(\$c->get(JobQueueInterface::class),"
                . "\n      retryPolicy: new RetryPolicy(3, 100, 30_000),"
                . "\n      deadLetterQueue: \$c->get('zef.queue.failed'))",
            );
        }

        return $container->get($id);
    };

    exit((new \Zef\Framework\Console\Inspector\QueueWorker($workerFactory, $io))->run(
        zef_cli_options(array_slice($args, 2)),
    ));
}

if ($command === 'queue:failed') {
    $app = \Zef\App\Bootstrap::createApp(false);
    $app->boot();
    $container = $app->getContainer();
    $failedQueueFactory = static function () use ($container): \Zef\Framework\Job\RedisStreamJobQueue {
        foreach ([
            'zef.queue.failed' => 'failed-job queue (zef.queue.failed)',
            \Zef\Framework\Job\RedisStreamJobQueue::class => 'failed-job queue (RedisStreamJobQueue)',
        ] as $id => $label) {
            if ($container->has($id)) {
                return $container->get($id);
            }
        }
        throw new \RuntimeException(
            "No failed-job queue is wired in the container (looked for 'zef.queue.failed'"
            . ' and ' . \Zef\Framework\Job\RedisStreamJobQueue::class . ").\n"
            . 'Register one from a ConfigProvider, e.g. a dedicated Redis stream:'
            . "\n  \$services['zef.queue.failed'] = fn () => new RedisStreamJobQueue("
            . "\$c->get(\\Redis::class), 'failed');"
            . "\nand wire it as InProcessJobWorker's deadLetterQueue.",
        );
    };
    $jobsProvider = static function (int $max) use ($failedQueueFactory): iterable {
        return $failedQueueFactory()->peek($max);
    };

    exit((new \Zef\Framework\Console\Inspector\QueueFailedLister($jobsProvider, $io))->run(
        zef_cli_options(array_slice($args, 2)),
    ));
}

if ($command === 'queue:retry') {
    $app = \Zef\App\Bootstrap::createApp(false);
    $app->boot();
    $container = $app->getContainer();
    $mainQueueFactory = static function () use ($container): \Zef\Framework\Job\JobQueueInterface {
        $id = \Zef\Framework\Job\JobQueueInterface::class;
        if (!$container->has($id)) {
            throw new \RuntimeException("JobQueueInterface ({$id}) is not wired in the container.");
        }

        return $container->get($id);
    };
    $failedQueueFactory = static function () use ($container): \Zef\Framework\Job\JobQueueInterface {
        foreach (['zef.queue.failed'] as $id) {
            if ($container->has($id)) {
                return $container->get($id);
            }
        }
        throw new \RuntimeException(
            "No failed-job queue is wired in the container (looked for 'zef.queue.failed').\n"
            . 'Register one from a ConfigProvider, e.g. a dedicated Redis stream:'
            . "\n  \$services['zef.queue.failed'] = fn () => new RedisStreamJobQueue("
            . "\$c->get(\\Redis::class), 'failed');"
            . "\nand wire it as InProcessJobWorker's deadLetterQueue.",
        );
    };

    exit((new \Zef\Framework\Console\Inspector\QueueRetry($mainQueueFactory, $failedQueueFactory, $io))->run(
        zef_cli_options(array_slice($args, 2)),
    ));
}

if ($command === 'queue:flush') {
    $app = \Zef\App\Bootstrap::createApp(false);
    $app->boot();
    $container = $app->getContainer();
    $failedQueueFactory = static function () use ($container): \Zef\Framework\Job\JobQueueInterface {
        if ($container->has('zef.queue.failed')) {
            return $container->get('zef.queue.failed');
        }
        throw new \RuntimeException(
            "No failed-job queue is wired in the container (looked for 'zef.queue.failed').\n"
            . 'Register one from a ConfigProvider, e.g. a dedicated Redis stream:'
            . "\n  \$services['zef.queue.failed'] = fn () => new RedisStreamJobQueue("
            . "\$c->get(\\Redis::class), 'failed');"
            . "\nand wire it as InProcessJobWorker's deadLetterQueue.",
        );
    };

    exit((new \Zef\Framework\Console\Inspector\QueueFlush($failedQueueFactory, $io))->run(
        zef_cli_options(array_slice($args, 2)),
    ));
}

if ($command === 'outbox:work') {
    $app = \Zef\App\Bootstrap::createApp(false);
    $app->boot();
    $container = $app->getContainer();
    $relayFactory = static function () use ($container): \Zef\Framework\EventSourcing\OutboxRelay {
        $id = \Zef\Framework\EventSourcing\OutboxRelay::class;
        if (!$container->has($id)) {
            throw new \RuntimeException(
                "OutboxRelay ({$id}) is not wired in the container.\n"
                . 'Register it from a ConfigProvider, e.g.:'
                . "\n  new OutboxRelay(\$c->get(OutboxStoreInterface::class), \$c->get(EventBusInterface::class))",
            );
        }

        return $container->get($id);
    };

    exit((new \Zef\Framework\Console\Inspector\OutboxWorker($relayFactory, $io))->run(
        zef_cli_options(array_slice($args, 2)),
    ));
}

if ($command === 'list' || ($command !== null && str_starts_with((string) $command, 'make:'))) {
    exit($maker->run($args));
}

if ($command !== null) {
    fwrite(STDERR, "Unknown command '{$command}'. Run 'bin/zef list' for all commands.\n");
    exit(1);
}

fwrite(STDOUT, "ZEF Framework v" . \Zef\Framework\Foundation\ZefVersion::VERSION . "\nRun 'bin/zef list' for all commands, --self-test for diagnostics, --serve for the dev server.\n");
exit(0);

// ---------------------------------------------------------------------------

/**
 * Parse `--key=value` / `--flag` switches into a string-keyed map
 * (shared by the v2.31.0 operational commands).
 *
 * @param list<string> $argv
 *
 * @return array<string, string|bool>
 */
function zef_cli_options(array $argv): array
{
    $options = [];
    foreach ($argv as $arg) {
        if (!str_starts_with((string) $arg, '--')) {
            continue;
        }
        $pair = substr((string) $arg, 2);
        if (str_contains($pair, '=')) {
            [$key, $value] = explode('=', $pair, 2);
            $options[$key] = $value;
        } else {
            $options[$pair] = true;
        }
    }

    return $options;
}

function zef_route_list(array $argv = []): int
{
    $json = in_array('--json', $argv, true);
    $app = \Zef\App\Bootstrap::createApp(false);
    $app->boot();
    $routes = $app->getRouter()->getRoutes();

    if ($json) {
        $exported = [];
        foreach ($routes as $route) {
            $exported[] = [
                'method' => $route['method'],
                'path' => $route['pattern'],
                'name' => $route['name'] ?? null,
                'handler' => $route['handler'],
                'module' => $route['module'] ?? null,
                'priority' => $route['priority'],
                'middleware' => $route['middleware'] ?? [],
                'host' => $route['host'] ?? '',
                'bindings' => $route['bindings'] ?? [],
                'accepts' => $route['accepts'] ?? [],
            ];
        }
        fwrite(STDOUT, (string) json_encode($exported, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES) . "\n");

        return 0;
    }

    printf("%-8s %-34s %-20s %-30s %-9s %-6s %-22s %s\n", 'METHOD', 'PATH', 'NAME', 'HANDLER', 'MODULE', 'PRIO', 'MIDDLEWARE', 'HOST');
    foreach ($routes as $route) {
        $middleware = $route['middleware'] ?? [];
        printf(
            "%-8s %-34s %-20s %-30s %-9s %-6d %-22s %s\n",
            $route['method'],
            $route['pattern'],
            $route['name'] ?? '-',
            $route['handler'],
            $route['module'] ?? '-',
            $route['priority'],
            $middleware === [] ? '-' : implode(',', $middleware),
            ($route['host'] ?? '') === '' ? '-' : $route['host'],
        );
    }
    printf("\n%d route(s)\n", count($routes));

    return 0;
}

/**
 * bin/zef openapi:generate — v2.20.0 OpenAPI documentation module.
 *
 * Assembles the spec from the booted route table (attribute metadata of
 * handler classes is merged when the container can resolve the service
 * id) and writes openapi.json / openapi.yaml (+ optional Postman export).
 */
function zef_openapi_generate(array $argv): int
{
    $options = [];
    foreach ($argv as $arg) {
        if (!str_starts_with((string) $arg, '--')) {
            continue;
        }
        $pair = substr((string) $arg, 2);
        if (str_contains($pair, '=')) {
            [$key, $value] = explode('=', $pair, 2);
        } else {
            $key = $pair;
            $value = 'true';
        }
        $options[$key] = $value;
    }

    $app = \Zef\App\Bootstrap::createApp(false);
    $app->boot();
    $routes = $app->getRouter()->getRoutes();
    $container = $app->getContainer();
    $resolver = static function (string $handler) use ($container): ?string {
        try {
            $service = $container->get($handler);
        } catch (\Throwable) {
            return null;
        }

        return is_object($service) ? $service::class : null;
    };

    return (new \Zef\Framework\OpenApi\Console\GenerateSpecCommand())
        ->run(new \Zef\Framework\Console\ConsoleIO(), $routes, $resolver, $options);
}

function zef_tinker(array $argv): int
{
    $expression = null;
    $boot = true;
    $force = false;
    foreach ($argv as $i => $arg) {
        if ($arg === '-e' && isset($argv[$i + 1])) {
            $expression = (string) $argv[$i + 1];
        } elseif (str_starts_with((string) $arg, '-e=')) {
            $expression = (string) substr((string) $arg, 3);
        } elseif ($arg === '--no-boot') {
            $boot = false;
        } elseif ($arg === '--force') {
            $force = true;
        }
    }
    if (!$force && strcasecmp((string) (getenv('ZEF_ENV') ?: ''), 'production') === 0) {
        fwrite(STDERR, "Refusing to run tinker with ZEF_ENV=production (REPL executes arbitrary code). Use --force to override.\n");
        return 1;
    }

    // The composition root is always created so `$container` is available even
    // with `--no-boot` (docs/CLI.md §5: "hanya container berdiri sendiri") —
    // issue #211: the REPL previously started with zero variables, so the
    // documented example `$container->get(...)` failed outright. `boot()`
    // (providers' boot hooks, dispatch readiness) is what gets skipped.
    $vars = [];
    $app = \Zef\App\Bootstrap::createApp(false);
    $vars['container'] = $app->getContainer();
    if ($boot) {
        $app->boot();
        $vars['app'] = $app;
    }

    $session = new \Zef\Framework\Runtime\TinkerSession($vars);

    if ($expression !== null) {
        echo $session->evaluate($expression) . "\n";
        return 0;
    }

    $isInteractive = function_exists('posix_isatty')
        ? posix_isatty(STDIN)
        : (getenv('TERM') !== false && stream_isatty(STDIN));
    if (!$isInteractive) {
        // Piped input: process the whole stream, print outputs as they come.
        $lines = explode("\n", (string) stream_get_contents(STDIN));
        foreach ($session->run($lines) as $output) {
            echo $output . "\n";
        }
        return 0;
    }

    fwrite(STDOUT, "ZEF tinker — variables: " . implode(', ', array_keys($vars)) . " (exit/quit to leave)\n");
    while (true) {
        fwrite(STDOUT, '>>> ');
        $line = fgets(STDIN);
        if ($line === false) {
            fwrite(STDOUT, "\n");
            return 0;
        }
        echo $session->evaluate(rtrim((string) $line, "\r\n")) . "\n";
        $last = strtolower(trim((string) $line));
        if ($last === 'exit' || $last === 'quit') {
            return 0;
        }
    }
}
