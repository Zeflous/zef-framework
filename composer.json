{
    "name": "mbetixz/zef-framework",
    "description": "Hexagonal PHP 8.4 framework — PSR-15 middleware, RoadRunner runtime, fiber-native async, radix-tree routing",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "mbetixz"
        }
    ],
    "require": {
        "php": "^8.4",
        "spiral/roadrunner-http": "^4.1",
        "nyholm/psr7": "^1.8"
    },
    "require-dev": {
        "code-lts/doctum": "^5.6",
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/phpstan": "^2.2",
        "phpstan/phpstan-strict-rules": "^2.0",
        "squizlabs/php_codesniffer": "^3.13",
        "slevomat/coding-standard": "^8.15",
        "phpunit/phpunit": "^10.0",
        "ext-redis": "*",
        "rector/rector": "^2.6",
        "infection/infection": "^0.30",
        "phpbench/phpbench": "^1.4",
        "deptrac/deptrac": "^4.7"
    },
    "config": {
        "allow-plugins": {
            "infection/extension-installer": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "audit": {
            "abandoned": "report"
        }
    },
    "autoload": {
        "psr-4": {
            "Zef\\App\\": "src/",
            "Zef\\Framework\\": [
                "src/Domain/",
                "src/Application/",
                "src/Infrastructure/",
                "src/Adapters/"
            ],
            "Zef\\Middleware\\": "src/Middleware/",
            "Zef\\Module\\": "modules/",
            "Zef\\Plugin\\": "plugins/"
        },
        "files": [
            "autoload/zef_autoload.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Zef\\Test\\": "tests/",
            "Zef\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "coverage": "phpunit --coverage-text",
        "coverage:gate": [
            "phpunit --coverage-clover build/clover.xml --coverage-text",
            "php scripts/ci/assert-coverage.php 90"
        ],
        "format": "php-cs-fixer fix --using-cache=no",
        "format:check": "php-cs-fixer check --diff --using-cache=no",
        "phpcs": "phpcs",
        "phpcbf": "phpcbf",
        "rector": "rector process",
        "rector:check": "rector process --dry-run --no-progress-bar",
        "stan": "phpstan analyse --configuration=phpstan.neon.dist --memory-limit=1G",
        "docs": "php vendor/bin/doctum.php update doctum.php --no-progress",
        "audit:security": "@php scripts/ci/assert-abandoned-policy.php",
        "deptrac": "deptrac analyse --config-file=deptrac.yaml --no-progress --fail-on-uncovered",
        "mutation": "infection --threads=max --min-msi=85 --min-covered-msi=90",
        "mutation:ci": "infection --threads=max --min-msi=85 --min-covered-msi=90 --logger-github",
        "mutation:zones": "php scripts/ci/assert-zone-coverage.php --floor=95",
        "stan:ratchet": "php scripts/ci/assert-phpstan-baseline.php",
        "bench": "phpbench run --report=aggregate --progress=none",
        "lint": "@php scripts/lint.php",
        "serve": "@php -S 0.0.0.0:8080 public/index.php"
    },
    "keywords": [
        "php",
        "framework"
    ],
    "homepage": "https://github.com/Zeflous/zef-framework",
    "support": {
        "issues": "https://github.com/Zeflous/zef-framework/issues",
        "docs": "https://zeflous.github.io/zef-framework/",
        "source": "https://github.com/Zeflous/zef-framework"
    },
    "suggest": {
        "ext-redis": "Redis-backed distributed rate limiter store (src/Infrastructure/Security/RedisRateLimiter)",
        "ext-apcu": "APCu-backed rate limiter for single-instance deployments (src/Infrastructure/Security/ApcuRateLimiter)",
        "ext-curl": "cURL transport for the S3-compatible object storage adapter (src/Infrastructure/Storage/CurlS3HttpTransport)",
        "ext-simplexml": "XML parsing for S3 ListObjectsV2 listing responses (src/Infrastructure/Storage/S3CompatibleStorage)"
    }
}
