# ZEF Framework — PHPStan configuration (composer stan).
#
# v2.13.0 hardening: analysis runs at LEVEL MAX with the official
# phpstan-strict-rules extension (booleans-in-conditions, no implicit
# mixed, disallowed loose constructs).
#
# treatPhpDocTypesAsCertain is deliberately FALSE (see the parameter at the
# bottom of this file). The header used to claim the opposite, which made the
# configuration read as stricter than it is. The setting is kept off on
# purpose: turning it on promotes every phpDoc annotation to a certainty and
# surfaces findings outside the frozen baseline, so it is a deliberate,
# separately-measured change rather than a comment fix.
#
# The frozen baseline (phpstan-baseline.neon) is regenerated only on
# purpose; CI fails on any error outside it (reportUnmatchedIgnoredErrors).
#
# src/Compat is excluded: byte-stable PSR shims of the v2.7.0 extraction.

includes:
    - phpstan-baseline.neon
    - vendor/phpstan/phpstan-strict-rules/rules.neon

parameters:
    level: max
    paths:
        - src
        - modules
        - plugins
        - app
        - tests
    bootstrapFiles:
        - autoload/zef_autoload.php
    excludePaths:
        path: src/Compat
    treatPhpDocTypesAsCertain: false
