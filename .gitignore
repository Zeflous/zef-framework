/vendor/
/build/
/.phpunit.cache/
# A trailing slash matches only a DIRECTORY, so the cache FILE of the same name
# stayed committable — it was swept into a commit once. Dropping the slash makes
# the pattern match the file too. The leading slash anchors it to the repository
# root (as before), so a nested directory of this name is covered by neither
# form; that is deliberate, the tool only writes the cache at the root.
/.php-cs-fixer.cache
/infection.log
composer.phar
/.deptrac.cache

# RoadRunner worker binary.
# `bin/rr` is a downloaded release asset (~62 MB), not source. It was sitting
# untracked in the working tree with no ignore rule, so an unguarded
# `git add -A` would have committed a 62 MB binary into the repository.
/bin/rr

# Ad-hoc per-zone Infection configs.
# The canonical config is /infection.json5. The committed
# infection-chunk-*.json5 and infection-fullrun.json5 files are historical
# campaign records (mapped in docs/QUALITY.md). Generated per-zone configs
# (e.g. `infection-zone-<name>.json5`, written by the mutation-campaign
# tooling at the repository root because Infection resolves relative source
# paths against the CONFIG FILE's directory) must never be committed.
/infection-zone-*.json5

# Local dev wrapper for running PHP under Xdebug (machine-specific path).
# `bin-xd/php` execs /home/z/.local/bin/php-xdebug — it slipped into PR #53's
# commit and is useless on any other machine. The wrapper is regeneratable
# in one line, so it stays local and out of git.
/bin-xd/

# Compiled application configuration (ConfigCompiler::export). The file bakes
# every `%secret:name%` reference into plaintext on disk, so the recommended
# target below must never be committed; keep its file permissions restricted
# to the runtime user instead (the compiler already writes chmod 0600).
/var/cache/config.php

# Python bytecode
__pycache__/
*.pyc
